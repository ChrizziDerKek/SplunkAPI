SPLUNK_HEC_URL=https://splunk:8088/services/collector/event
SPLUNK_HEC_IGNORE_CERT_ERRORS=true

SPLUNK_MANAGEMENT_URL=https://splunk-management:8089
SPLUNK_MANAGEMENT_IGNORE_CERT_ERRORS=true

SPLUNK_API_TOKEN=<token>

SPLUNK_SEARCH_MAXOUT=5000
SPLUNK_SEARCH_MAXTIME=60
SPLUNK_SEARCH_POLL_INTERVAL_MS=250